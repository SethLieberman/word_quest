<% content_for :title, "Fleet Quest | Room unavailable" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "fleet", "data-turbo-track": "reload" %>
<% end %>
<main class="fleet-game">
  <section class="fleet-panel">
    <h1>Room unavailable</h1>
    <p role="alert"><%= @message %></p>
    <a class="quest-switch" href="<%= fleet_games_path %>">Back to Fleet Quest</a>
  </section>
</main>
